{
  "id": "no.husmodus",
  "version": "0.4.0",
  "compatibility": ">=12.3.0",
  "sdk": 3,
  "platforms": [
    "local"
  ],
  "name": {
    "no": "House Guard",
    "en": "House Guard"
  },
  "description": {
    "no": "Hjem, borte og natt med tydelige rutiner",
    "en": "Home, away and night routines with clear status"
  },
  "category": [
    "tools"
  ],
  "brandColor": "#e8441a",
  "permissions": [
    "homey:manager:api"
  ],
  "author": {
    "name": "House Guard"
  },
  "source": "https://github.com/5olvik/house-guard",
  "support": "https://github.com/5olvik/house-guard/issues",
  "capabilities": {
    "alarm_status": {
      "type": "string",
      "title": {
        "no": "Alarmstatus",
        "en": "Alarm status"
      },
      "getable": true,
      "setable": false,
      "uiComponent": "sensor",
      "icon": "/assets/icon.svg"
    }
  },
  "images": {
    "small": "/assets/images/small.png",
    "large": "/assets/images/large.png",
    "xlarge": "/assets/images/xlarge.png"
  },
  "drivers": [
    {
      "id": "guest-mode",
      "name": {
        "no": "Gjestemodus",
        "en": "Guest mode"
      },
      "class": "other",
      "platforms": [
        "local"
      ],
      "capabilities": [
        "onoff"
      ],
      "capabilitiesOptions": {
        "onoff": {
          "title": {
            "no": "Gjestemodus",
            "en": "Guest mode"
          },
          "preventInsights": true,
          "zoneActivity": false
        }
      },
      "images": {
        "small": "/drivers/guest-mode/assets/images/small.png",
        "large": "/drivers/guest-mode/assets/images/large.png",
        "xlarge": "/drivers/guest-mode/assets/images/xlarge.png"
      },
      "pair": [
        {
          "id": "list_devices",
          "template": "list_devices",
          "navigation": {
            "next": "add_devices"
          },
          "options": {
            "singular": true
          }
        },
        {
          "id": "add_devices",
          "template": "add_devices"
        }
      ]
    },
    {
      "id": "alarm-panel",
      "name": {
        "no": "Alarmpanel",
        "en": "Alarm panel"
      },
      "class": "sensor",
      "platforms": [
        "local"
      ],
      "capabilities": [
        "homealarm_state",
        "alarm_generic",
        "alarm_status",
        "button"
      ],
      "capabilitiesOptions": {
        "button": {
          "title": {
            "no": "Frakoble og avstill",
            "en": "Disarm and silence"
          }
        },
        "alarm_generic": {
          "title": {
            "no": "Utløst alarm",
            "en": "Alarm triggered"
          },
          "zoneActivity": false
        }
      },
      "images": {
        "small": "/drivers/alarm-panel/assets/images/small.png",
        "large": "/drivers/alarm-panel/assets/images/large.png",
        "xlarge": "/drivers/alarm-panel/assets/images/xlarge.png"
      },
      "pair": [
        {
          "id": "list_devices",
          "template": "list_devices",
          "navigation": {
            "next": "add_devices"
          },
          "options": {
            "singular": true
          }
        },
        {
          "id": "add_devices",
          "template": "add_devices"
        }
      ]
    }
  ],
  "api": {
    "checkIntegrationAccess": {
      "method": "POST",
      "path": "/integration-access"
    },
    "getState": {
      "method": "GET",
      "path": "/state"
    },
    "getCatalog": {
      "method": "GET",
      "path": "/catalog"
    },
    "saveConfig": {
      "method": "PUT",
      "path": "/config"
    },
    "validateConfig": {
      "method": "POST",
      "path": "/validate"
    },
    "command": {
      "method": "POST",
      "path": "/command"
    },
    "previewRoutine": {
      "method": "POST",
      "path": "/preview"
    },
    "setupBridges": {
      "method": "POST",
      "path": "/bridges"
    }
  },
  "flow": {
    "actions": [
      {
        "id": "answer_night_question",
        "title": {
          "no": "Registrer svar på nattspørsmålet",
          "en": "Record the answer to the night question"
        },
        "hint": {
          "no": "Bruk taggen Dette spørsmålet fra Når-kortet. Gamle svar ignoreres.",
          "en": "Use the This question tag from the When card. Expired replies are ignored."
        },
        "args": [
          {
            "name": "reply",
            "type": "text",
            "title": {
              "no": "Dette spørsmålet",
              "en": "Dette spørsmålet"
            }
          },
          {
            "name": "answer",
            "type": "dropdown",
            "title": {
              "no": "Svar",
              "en": "Svar"
            },
            "values": [
              {
                "id": "yes",
                "title": {
                  "no": "Ja",
                  "en": "Yes"
                }
              },
              {
                "id": "no",
                "title": {
                  "no": "Nei",
                  "en": "No"
                }
              }
            ]
          }
        ],
        "titleFormatted": {
          "no": "Registrer svar på nattspørsmålet: [[reply]] · [[answer]]",
          "en": "Record the answer to the night question: [[reply]] · [[answer]]"
        }
      },
      {
        "id": "check_integration_access",
        "deprecated": true,
